{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "py ./typer.py build -p '${input:projectPath}' -b ${input:buildNumber}",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Pack",
            "type": "shell",
            "command": "py ./typer.py pack -p '${input:projectPath}'",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Upload",
            "type": "shell",
            "command": "py ./typer.py upload -p '${input:projectPath}'",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "New",
            "type": "shell",
            "command": "py ./typer.py new -n '${input:projectName}' -o '${input:projectPath}' --noCommit --test --dev -d 'Udrian@TypeOCore-0.1.0.dev'",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ],
    "inputs": [
        {
            "id": "projectName",
            "type": "promptString",
            "description": "Name of the new project to create",
            "default": ""
        },
        {
            "id": "projectPath",
            "type": "promptString",
            "description": "Path to project folder",
            "default": "D:\\projects\\typeo\\"
        },
        {
            "id": "module",
            "type": "pickString",
            "options": ["TypeOCore", "TypeOBasic2d", "TypeODesktop", "TypeOSDL", "Editor/TypeDCore", "Editor/TypeDSDL", "Editor/TypeD", "Editor/TypeDitor"],
            "description": "Module name"
        },
        {
            "id": "buildNumber",
            "type": "promptString",
            "description": "Build number",
            "default": "0"
        }
    ]
}